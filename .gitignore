# Secrets and local configuration
.env
.env.*
!.env.example
*.key
*.pem
!backend/testdata/**/*.pem
!backend/testdata/**/*.key
# The master key file has no extension, so *.key does not match it. Committing it
# would publish the one secret that decrypts every stored credential.
secrets/
!secrets/.gitkeep

# Runtime state
/data/
*.db
*.db-wal
*.db-shm
/recordings/

# Go
backend/bin/
backend/coverage.out
backend/coverage.html

# Node
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
npm-debug.log*
pnpm-debug.log*

# Editors and OS
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
