# AXT-Term configuration.
#
# Copy to .env and edit. Every variable is documented in docs/configuration.md,
# which is generated from the code that parses these values.
#
# AXT-Term validates all of this at startup and refuses to run on an invalid
# value, reporting every problem at once rather than one restart at a time.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

AXT_ENV=production

# The URL browsers use. This determines two things that break silently if wrong:
# whether session cookies get the Secure attribute, and the default accepted
# origin for HTTP and WebSocket requests. Set it to what users actually type.
AXT_PUBLIC_URL=https://axt-term.local

AXT_HTTP_ADDR=:8080
AXT_DATA_DIR=/var/lib/axt-term

AXT_LOG_LEVEL=info
AXT_LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Credential encryption  (REQUIRED)
# ---------------------------------------------------------------------------
#
# Stored SSH keys and passwords are encrypted with this key. It is never written
# to the database: an attacker with a copy of the database file alone gets
# nothing usable.
#
# Generate one:
#     openssl rand -base64 32
#
# Prefer AXT_MASTER_KEY_FILE over AXT_MASTER_KEY: file permissions are a real
# boundary, while environment variables are inherited by child processes and
# visible in container inspection output.
#
# WARNING: losing this key means losing every stored credential. There is no
# recovery path -- that is the point. Back it up separately from the database,
# because a backup containing both is a backup of your plaintext secrets.

AXT_MASTER_KEY_FILE=/run/secrets/axt_master_key
# AXT_MASTER_KEY=
# AXT_MASTER_PASSPHRASE=

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------
#
# X-Forwarded-For is only trusted from these networks. Leave empty when nothing
# proxies AXT-Term: trusting the header unconditionally would let any client
# forge the address recorded in the audit log and bypass per-IP rate limiting.
# The Docker Compose default is Caddy's bridge network.

AXT_TRUSTED_PROXIES=172.20.0.0/16

# Additional accepted origins, if AXT_PUBLIC_URL is not the only one.
# AXT_ALLOWED_ORIGINS=https://axt-term.local,https://axt.internal

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------

AXT_SESSION_IDLE_TIMEOUT=8h
AXT_SESSION_MAX_LIFETIME=168h

# How long a terminal session keeps running after the last browser detaches.
# This is what lets a long upgrade survive a browser reload or a dropped VPN.
AXT_SESSION_IDLE_CLOSE=30m

# Output retained per session and replayed when a browser reattaches. Larger
# survives longer disconnections; costs memory per idle session.
AXT_SESSION_RING_BUFFER=262144

AXT_MAX_SESSIONS_PER_USER=50

# ---------------------------------------------------------------------------
# SSH
# ---------------------------------------------------------------------------

# tofu   - prompt for confirmation the first time a host key is seen, then pin it
# strict - accept only already-trusted keys
# A key that changes after being trusted always fails, under either policy.
AXT_SSH_HOSTKEY_POLICY=tofu

AXT_SSH_CONNECT_TIMEOUT=15s
AXT_SSH_KEEPALIVE_INTERVAL=30s
AXT_SSH_MAX_HOPS=5

# Permit outdated ciphers and SHA-1 signatures for network equipment that offers
# nothing better. Hosts relying on this are badged in the UI.
AXT_SSH_LEGACY_ALGOS=false

# Mount an agent socket into the container to enable agent authentication.
# AXT_SSH_AGENT_SOCKET=/run/ssh-agent.sock

# ---------------------------------------------------------------------------
# Files and transfers
# ---------------------------------------------------------------------------

AXT_TRANSFER_WORKERS=4
AXT_UPLOAD_MAX_BYTES=0
AXT_EDITOR_MAX_BYTES=8388608

# ---------------------------------------------------------------------------
# Tunnels
# ---------------------------------------------------------------------------

# Off by default. A tunnel that silently exposes an internal database to the
# local network is an incident, not a convenience.
AXT_TUNNEL_ALLOW_PUBLIC_BIND=false

# ---------------------------------------------------------------------------
# RDP  (Phase 2)
# ---------------------------------------------------------------------------
#
# host:port of guacd. Empty disables RDP and VNC. The Compose stack keeps guacd
# on an internal network with no published port; RDP credentials are decrypted
# server-side and never reach the browser.

AXT_GUACD_ADDR=guacd:4822

# ---------------------------------------------------------------------------
# Audit
# ---------------------------------------------------------------------------

# off      - session open and close only
# commands - commands issued through the UI; not raw interactive keystrokes
# full     - complete session recordings to disk. These routinely contain
#            secrets and must be protected like the credential store.
AXT_COMMAND_LOGGING=commands

# 0 retains indefinitely. Pruning is an explicit admin action, never automatic
# and never reachable from the web UI.
AXT_AUDIT_RETENTION_DAYS=0

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

AXT_RATELIMIT_LOGIN_PER_IP=5
AXT_RATELIMIT_LOGIN_PER_USER=10
AXT_RATELIMIT_LOGIN_WINDOW=5m
AXT_LOCKOUT_THRESHOLD=10
AXT_LOCKOUT_DURATION=15m
AXT_RATELIMIT_PER_MINUTE=600
AXT_RATELIMIT_BURST=60

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

AXT_METRICS_ENABLED=false
AXT_SHUTDOWN_GRACE=20s
